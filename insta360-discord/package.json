{
  "name": "insta360-discord",
  "version": "1.0.0",
  "description": "Puente para llevar el directo de una Insta360 GO Ultra (RTMP) a Discord: aviso automático, visor de baja latencia y Actividad en el canal de voz.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "simular-camara": "node scripts/simular-camara.mjs",
    "build:sdk": "node scripts/build-discord-sdk.mjs"
  },
  "dependencies": {
    "hls.js": "1.7.4",
    "mpegts.js": "1.8.2",
    "ws": "^8.23.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@discord/embedded-app-sdk": "2.5.0",
    "esbuild": "^0.28.2"
  }
}
